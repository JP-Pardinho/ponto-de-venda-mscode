{% extends 'base.html.twig' %}

{% block title %}Pagamento - Venda #{{ venda.id }}{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-3">
                
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-cash-coin me-2"></i>
                        Pagamento
                    </h1>
                    <span class="badge bg-secondary">Venda #{{ venda.id }}</span>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link disabled" href="#">
                            <i class="bi bi-cart"></i> Itens
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link disabled" href="#">
                            <i class="bi bi-person"></i> Cliente e Entrega
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-cash"></i> Pagamento
                        </a>
                    </li>
                </ul>

                {% include '/partials/error-mensage.html.twig' %}

                <div class="row g-4">
                    
                    <div class="col-12 col-lg-7">
                        <h5 class="mb-3">Resumo da Conta</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered mb-4">
                                <tbody>
                                    <tr>
                                        <td>Total Produtos</td>
                                        <td class="text-end">
                                            <strong>R$ {{ venda.valorTotal|number_format(2, ',', '.') }}</strong>
                                        </td>
                                    </tr>
                                    <tr class="text-danger">
                                        <td>Desconto</td>
                                        <td class="text-end">
                                            <strong>
                                                - R$ {{ venda.valorDesconto|default(0)|number_format(2, ',', '.') }}
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr class="table-light">
                                        <td><strong>Total Final</strong></td>
                                        <td class="text-end">
                                            <strong class="fs-5 text-primary">
                                                R$
                                                {{ (venda.valorTotal - venda.valorDesconto)|number_format(2, ',', '.') }}
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <h5 class="mb-3">Pagamentos Realizados</h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Forma de Pagamento</th>
                                        <th class="text-end">Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for pagamento in venda.pagamentos %}
                                        <tr class="align-middle">
                                            <td>{{ pagamento.tipoPagamento }}</td>
                                            <td class="text-end text-success">
                                                <strong>{{ pagamento.parcelas == 1 ? '' : pagamento.parcelas  ~ 'x' }}</strong> 
                                                <strong>R$ {{ pagamento.valor|number_format(2, ',', '.') }}</strong>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="2" class="text-center text-muted py-3">
                                                Nenhum pagamento realizado ainda.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th>Total Pago</th>
                                        <th class="text-end">
                                            R$ {{ totalPago|number_format(2, ',', '.') }}
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="col-12 col-lg-5">
                        <div class="card bg-light">
                            <div class="card-body">
                                
                                {% if restante > 0 %}
                                    <div class="text-center mb-4">
                                        <small class="text-muted text-uppercase">Valor Restante</small>
                                        <h2 class="text-danger mb-0">
                                            R$ {{ restante|number_format(2, ',', '.') }}
                                        </h2>
                                    </div>

                                    <hr>

                                    {{ form_start(form) }}
                                        <div class="mb-3">
                                            {{ form_row(form.tipoPagamento) }}
                                        </div>
                                        
                                        {{ form_row(form.parcelas) }}

                                        <div class="mb-4">
                                            {{ form_label(form.valor) }}
                                            <div class="input-group">
                                                {{ form_widget(form.valor) }}
                                            </div>
                                        </div>

                                        {{ form_row(form.adicionar) }}
                                    {{ form_end(form) }}

                                {% else %}
                                    <div class="text-center mb-4">
                                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                                        <h4 class="mt-3">Conta Quitada!</h4>
                                        <p class="text-muted">Todos os pagamentos foram realizados.</p>
                                    </div>

                                    {% if troco > 0 %}
                                        <div class="card bg-opacity-25 border-info mb-4">
                                            <div class="card-body">
                                                <small class="text-uppercase text-primary fw-bold">Entregar de Troco</small>
                                                <h1 class="text-primary mb-0">
                                                    R$ {{ troco|number_format(2, ',', '.') }}
                                                </h1>
                                            </div>
                                        </div>
                                    {% endif %}

                                    <form action="{{ path('pdv_concluir', {id: venda.id}) }}" method="POST">
                                        <button type="submit" class="btn btn-success w-100 btn-lg">
                                            <i class="bi bi-printer"></i> Finalizar e Emitir Recibo
                                        </button>
                                    </form>
                                {% endif %}

                            </div>
                        </div>
                        
                        <div class="text-center mt-3">
                            <a href="{{ path('pdv_dados_entrega', {id: venda.id}) }}"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </div>
                </div> 
            </div>
        </div>
    </div>
</div>
{% endblock %}