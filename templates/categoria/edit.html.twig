{% extends 'base.html.twig' %}

{% block title %}PDV - Editar Categoria{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-tags-fill me-2"></i>
                        Editar categoria #{{ categoria.id }}
                    </h1>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('listar_categorias') }}">
                            <i class="bi bi-list-ul"></i> Listar categorias
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_categoria_show') }}">
                            <i class="bi bi-plus"></i> Nova categoria
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="#" aria-disabled="true">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>

                <div class="w-100 mt-4">
                    {% include "/partials/error-mensage.html.twig" %}
                    <form action="{{ path('editar_categoria', {categoria: categoria.id}) }}" method="POST">
                        <div class="mb-3">
                            <label for="nome" class="form-label">
                                Nome:
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="nome"
                                   name="nome"
                                   minlength="3"
                                   required
                                   value="{{ categoria.nome }}">
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-md-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i>
                                Salvar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}