{% extends 'base.html.twig' %}

{% block title %}PDV - Categorias{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-tags-fill me-2"></i>
                        Categorias
                    </h1>
                </div>
                
                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-list-ul"></i> Listar categorias
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_categoria_show') }}">
                            <i class="bi bi-plus"></i> Nova categoria
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" tabindex="-1">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>
                
                {% include '/partials/error-mensage.html.twig' %}

                <form method="get" class="mb-3" action="{{ path('listar_categorias') }}">
                    <div class="input-group">
                        <input
                            type="search"
                            name="q"
                            value="{{ q|default('') }}"
                            class="form-control"
                            placeholder="Buscar por Categoria"
                        >
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Nome</th>
                                <th scope="col" class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for categoria in categorias %}
                                <tr>
                                    <th scope="row">{{ categoria.id }}</th>
                                    <td>{{ categoria.nome }}</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap gap-1">
                                            <a class="btn btn-secondary btn-sm"
                                               title="Editar"
                                               href="{{ path('editar_categoria_show', {categoria: categoria.id}) }}">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            {% if is_granted('ROLE_ADMIN') %}
                                                <form action="{{ path('remover_categoria', {categoria: categoria.id}) }}">
                                                    <button class="btn btn-danger btn-sm" title="Remover">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-center">
                                        Nenhuma categoria encontrada.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div> 
            </div>
        </div>
    </div>
</div>
{% endblock %}