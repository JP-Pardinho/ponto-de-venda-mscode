{% extends 'base.html.twig' %}

{% block title %}PDV - Categorias{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="container py-5">
                <div class="mb-4 d-flex flex-row justify-content-between">
                    <h1><i class="bi bi-tags-fill "></i> Categorias</h1>
                </div>
                
                <ul class="nav nav-tabs mb-3">

                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-list-ul"></i> Listar categorias
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('cadastrar_categoria_show') }}">
                            <i class="bi bi-plus"></i> Nova categoria
                        </a>
                    </li>
                </ul>
                
                {% include '/partials/error-mensage.html.twig' %}

                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Nome</th>
                            <th scope="col-1 text-align-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for categoria in categorias %}
                        <tr>
                            <th scope="row">{{ categoria.id }}</th>
                            <td>{{ categoria.nome }}</td>
                            <td class="col-1 text-align-right">
                                <a  class="btn btn-secondary btn-sm"
                                    title="Editar"
                                    href="{{ path('editar_categoria_show', {categoria: categoria.id}) }}">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a  class="btn btn-danger btn-sm"
                                    title="Remover"
                                    href="{{ path('remover_categoria', {categoria: categoria.id}) }}">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
