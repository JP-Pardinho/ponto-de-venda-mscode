{% extends 'base.html.twig' %}

{% block title %}Erro{% endblock %}

{% block body %}
<div class="row mt-5 align-items-center justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body py-5 text-center">
                
                <h1 class="display-4 fw-bold text-danger mb-3">
                    <i class="bi bi-x-octagon-fill"></i> {{ erro }}
                </h1>
                
                <div class="fs-5 text-muted mb-4">
                    {% include "/partials/error-mensage.html.twig" %}
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-center gap-3">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                    <a href="/" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-house"></i> Início
                    </a>
                </div>  
            </div>
        </div>
   </div>         
</div>
{% endblock %}