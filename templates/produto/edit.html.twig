{% extends 'base.html.twig' %}

{% block title %}PDV - Editar Produto{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-box-seam-fill me-2"></i>
                        Editar produto #{{ produto.id }}
                    </h1>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('listar_produtos') }}">
                            <i class="bi bi-list-ul"></i> Listar produtos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_produto') }}">
                            <i class="bi bi-plus"></i> Novo produto
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('ver_produto', {produto: produto.id}) }}">
                            <i class="bi bi-eye"></i> Visualizar
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>

                {% include "/partials/error-mensage.html.twig" %}

                <div class="w-100 mt-4">
                    {{ form_start(form) }}
                        {{ form_row(form.nome) }}
                        {{ form_row(form.descricao) }}
                        
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                {{ form_row(form.categoria) }}
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Quantidade:</label>
                                <input type="text"
                                       class="form-control"
                                       value="{{ produto.quantidadeEstoque }}"
                                       aria-label="Quantidade em estoque"
                                       disabled
                                       readonly>
                            </div>

                            <div class="col-12 col-md-4 d-none">
                                {{ form_row(form.quantidadeEstoque) }}
                            </div>

                            <div class="col-12 col-md-4">
                                {{ form_row(form.valor) }}
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-md-end gap-2 mt-4">
                            <a href="{{ path('editar_estoque_produto', {produto: produto.id}) }}"
                               class="btn btn-secondary">
                                <i class="bi bi-plus"></i>
                                Alterar quantidade em estoque
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> 
                                Cadastrar
                            </button>
                        </div>
                    {{ form_end(form) }}  
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}