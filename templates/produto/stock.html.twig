{% extends 'base.html.twig' %}

{% block title %}PDV - Editar Estoque{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-box-seam-fill me-2"></i>
                        Editar estoque #{{ produto.id }}
                    </h1>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('listar_produtos') }}">
                            <i class="bi bi-list-ul"></i> Listar produtos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_produto') }}">
                            <i class="bi bi-plus"></i> Novo produto
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('ver_produto', {produto: produto.id}) }}">
                            <i class="bi bi-eye"></i> Visualizar
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-pencil"></i> Editar estoque
                        </a>
                    </li>
                </ul>

                {% include "/partials/error-mensage.html.twig" %}

                <div class="w-100 mt-4">
                    {{ form_start(form) }}
                        {{ form_row(form.quantidadeAdicional) }}

                        <div class="d-flex flex-column flex-md-row justify-content-md-end gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> 
                                Alterar estoque
                            </button>
                        </div>
                    {{ form_end(form) }}  
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}