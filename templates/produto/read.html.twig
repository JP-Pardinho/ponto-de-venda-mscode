{% extends 'base.html.twig' %}

{% block title %}PDV - Detalhes do Produto{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-box-seam-fill me-2"></i>
                        Produto #{{ produto.id }}
                    </h1>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('listar_produtos') }}">
                            <i class="bi bi-list-ul"></i> Listar produtos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_produto') }}">
                            <i class="bi bi-plus"></i> Novo produto
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black active" href="#">
                            <i class="bi bi-eye"></i> Visualizar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('editar_produto', {produto: produto.id}) }}">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>

                <div class="w-100 mt-4">
                    {% include "/partials/error-mensage.html.twig" %}

                    <form>
                        <div class="mb-3">
                            <label class="form-label">Nome:</label>
                            <input type="text"
                                   class="form-control"
                                   value="{{ produto.nome }}"
                                   aria-label="Nome"
                                   disabled
                                   readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descrição:</label>
                            <input type="text"
                                   class="form-control"
                                   value="{{ produto.descricao }}"
                                   aria-label="Descrição"
                                   disabled
                                   readonly>
                        </div>

                        <div class="row g-3">
                            <div class="mb-3 col-12 col-md-6">
                                <label class="form-label">Categoria:</label>
                                <input type="text"
                                       class="form-control"
                                       value="{{ produto.categoria.nome }}"
                                       aria-label="Categoria"
                                       disabled
                                       readonly>
                            </div>

                            <div class="mb-3 col-12 col-md-6">
                                <label class="form-label">Data cadastro:</label>
                                <input type="text"
                                       class="form-control"
                                       value="{{ produto.dataCadastro|date('d/m/Y') }}"
                                       aria-label="Data cadastro"
                                       disabled
                                       readonly>
                            </div>

                            <div class="mb-3 col-12 col-md-6">
                                <label class="form-label">Quantidade:</label>
                                <input type="text"
                                       class="form-control"
                                       value="{{ produto.quantidadeEstoque }}"
                                       aria-label="Quantidade em estoque"
                                       disabled
                                       readonly>
                            </div>

                            <div class="mb-3 col-12 col-md-6">
                                <label class="form-label">Valor:</label>
                                <input type="text"
                                       class="form-control"
                                       value="R${{ produto.valor|number_format(2, ',', '.') }}"
                                       aria-label="Valor"
                                       disabled
                                       readonly>
                            </div>
                        </div>
                        
                        <div class="d-flex flex-column flex-md-row justify-content-md-end mt-3">
                            <a href="{{ path('listar_produtos') }}"
                               class="btn btn-secondary w-100 w-md-auto">
                                Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}