{% extends 'base.html.twig' %}

{% block title %}PDV - Produtos{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="container py-5">
                <div class="mb-4 d-flex flex-row justify-content-between">
                    <h1><i class="bi bi-box-seam-fill"></i> Produtos</h1>
                </div>
                
                <ul class="nav nav-tabs mb-3">

                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-list-ul"></i> Listar produtos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_produto') }}">
                            <i class="bi bi-plus"></i> Novo produto
                        </a>
                    </li>
                </ul>
                
                {% include '/partials/error-mensage.html.twig' %}

                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Nome</th>
                            <th scope="col">Categoria</th>
                            <th scope="col">Estoque</th>
                            <th scope="col">Valor</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for produto in produtos %}
                        <tr class="align-middle">
                            <th scope="row">{{ produto.id }}</th>
                            <td>{{ produto.nome }}</td>
                            <td>{{ produto.categoria.nome }}</td>
                            <td>{{ produto.quantidadeEstoque }}</td>
                            <td>R${{ produto.valor|number_format(2, ',', '.') }}</td>
                            
                            <td>
                                {% if produto.isAtivo %}
                                    <span class="badge bg-success">Ativo</span>
                                {% else %}
                                    <span class="badge bg-danger">Inativo</span>
                                {% endif %}
                            </td>
                            
                            <td class="col-1">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex gap-1">
                                        <a type="button"
                                           class="btn btn-primary btn-sm flex-fill"
                                           title="Vizualizar"
                                           href="{{ path('ver_produto', {produto: produto.id}) }}">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        
                                        <a type="button"
                                           class="btn btn-secondary btn-sm flex-fill"
                                           title="Editar"
                                           href="{{ path('editar_produto', {produto: produto.id}) }}">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form action="{{ path('remover_produto', {produto: produto.id}) }}" 
                                              method="POST" 
                                              class="flex-fill">
                                            <button type="submit"
                                                    class="btn btn-danger btn-sm w-100"
                                                    title="Excluir">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}