{% extends 'base.html.twig' %}

{% block title %}PDV - Produtos{% endblock %}

{% block body %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body py-4">
                    <div class="mb-4 d-flex flex-row justify-content-between align-items-center">
                        <h1 class="h3 mb-0">
                            <i class="bi bi-box-seam-fill me-2"></i>
                            Produtos
                        </h1>
                    </div>

                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">
                                <i class="bi bi-list-ul"></i>
                                Listar produtos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-black" href="{{ path('salvar_produto') }}">
                                <i class="bi bi-plus"></i>
                                Novo produto
                            </a>
                        </li>
                    </ul>

                    {% include '/partials/error-mensage.html.twig' %}

                    <form method="get" class="mb-3" action="{{ path('listar_produtos') }}">
                        <div class="input-group">
                            <input type="search"
                                   name="q"
                                   value="{{ q|default('') }}"
                                   class="form-control"
                                   placeholder="Buscar por Nome ou Categoria">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Id</th>
                                    <th scope="col">Nome</th>
                                    <th scope="col">Categoria</th>
                                    <th scope="col">Estoque</th>
                                    <th scope="col">Valor</th>
                                    <th scope="col">Status</th>
                                    <th scope="col" class="text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for produto in produtos %}
                                    <tr class="align-middle">
                                        <th scope="row">{{ produto.id }}</th>
                                        <td>{{ produto.nome }}</td>
                                        <td>{{ produto.categoria.nome }}</td>
                                        <td class="{{ produto.quantidadeEstoque < 50 ? 'text-danger fw-bold' : '' }}">
                                            {{ produto.quantidadeEstoque }}
                                        </td>
                                        <td>R${{ produto.valor|number_format(2, ',', '.') }}</td>

                                        <td>
                                            {% if produto.isAtivo %}
                                                <span class="badge bg-success">Ativo</span>
                                            {% else %}
                                                <span class="badge bg-danger">Inativo</span>
                                            {% endif %}
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex flex-wrap justify-content-center gap-1">
                                                {% set inativo = '' %}
                                                {% if not produto.isAtivo %}
                                                    {% set inativo = 'disabled' %}
                                                {% endif %}

                                                <a class="btn btn-primary btn-sm {{ inativo }}"
                                                   title="Visualizar"
                                                   href="{{ path('ver_produto', {produto: produto.id}) }}">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                                <a class="btn btn-secondary btn-sm {{ inativo }}"
                                                   title="Editar"
                                                   href="{{ path('editar_produto', {produto: produto.id}) }}">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                {% if produto.isAtivo %}
                                                    {% if not produto.vendaItems.isEmpty() %}
                                                        {% set message = 'Você tem certeza que deseja inativar este produto? (Produto vinculado a uma ou mais vendas)' %}
                                                    {% else %}
                                                        {% set message = 'Confirme a EXCLUSÃO permanente deste produto. (Esta ação não pode ser desfeita)' %}
                                                    {% endif %}
                                                    {% if is_granted('ROLE_ADMIN') %}
                                                        <form action="{{ path('remover_produto', {produto: produto.id}) }}"
                                                            method="POST"
                                                            class="d-inline-block">
                                                            <input type="hidden"
                                                                name="_token"
                                                                value="{{ csrf_token('delete' ~ produto.id) }}">
                                                            <button type="submit"
                                                                    class="btn btn-danger btn-sm"
                                                                    title="Excluir"
                                                                    onclick="return confirm('{{ message }}')">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                {% else %}
                                                    <form action="{{ path('reativar_produto', {produto: produto.id}) }}"
                                                          method="POST"
                                                          class="d-inline-block">
                                                        <button type="submit"
                                                                class="btn btn-success btn-sm"
                                                                title="Reativar">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            Nenhum produto encontrado.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div> 
                </div> 
            </div>
        </div>
    </div>
{% endblock %}
