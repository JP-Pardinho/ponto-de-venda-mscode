{% extends 'base.html.twig' %}

{% block title %}PDV - Inicío{% endblock %}

{% block body %}
<div class="row">
<div class="row mb-4">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="text-start mb-3">
                    <i class="bi bi-piggy-bank fs-2 text-success"></i>
                </div>
                <h5 class="card-header bg-transparent border-0 p-0 text-muted mb-2">Faturamento Total</h5>
                <p class="card-title fs-4 fw-bold text-dark">
                    R$ {{ faturamentoTotal|number_format(2, ',', '.') }}
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="text-start mb-3">
                    <i class="bi bi-receipt fs-2 text-primary"></i>
                </div>
                <h5 class="card-header bg-transparent border-0 p-0 text-muted mb-2">Total de Vendas</h5>
                <p class="card-title fs-4 fw-bold text-dark">
                    {{ numeroVendas }} <small class="fs-6 fw-normal text-muted">pedidos</small>
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="text-start mb-3">
                    <i class="bi bi-calendar-check fs-2 text-info"></i>
                </div>
                <h5 class="card-header bg-transparent border-0 p-0 text-muted mb-2">Vendas de Hoje</h5>
                <p class="card-title fs-4 fw-bold text-dark mb-0">
                    R$ {{ faturamentoHoje|number_format(2, ',', '.') }}
                </p>
                <small class="text-muted mt-1">
                    {{ qtdVendasHoje }} vendas realizadas hoje
                </small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history fs-4 me-2"></i>
                    Últimas Vendas
                </h5>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-2">#</th>
                            <th scope="col">Data/Hora</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Entrega</th>
                            <th scope="col" class="text-end">Valor Total</th>
                            <th scope="col" class="text-center">Status</th>
                            <th scope="col" class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>         
                        {% for venda in vendas %}
                            <tr>
                                <td class="ps-2">{{ venda.id }}</td>
                                
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">{{ venda.dataVenda|date('d/m/Y') }}</span>
                                        <small class="text-muted">{{ venda.dataVenda|date('H:i') }}</small>
                                    </div>
                                </td>

                                <td>
                                    {% if venda.cliente %}
                                        {{ venda.cliente.nome }}
                                    {% else %}
                                        Consumidor Final
                                    {% endif %}
                                </td>

                                <td>
                                    {% if venda.tipoEntrega == 'ENTREGA' and venda.status != 0 %}
                                        <span class="badge bg-info text-dark">
                                            Entrega
                                        </span>
                                    {% elseif venda.tipoEntrega == 'RETIRADA' and venda.status != 0 %}
                                        <span class="badge bg-secondary">
                                            Retirada
                                        </span>
                                    {% else %}
                                        <span>
                                            -
                                        </span>
                                    {% endif %}
                                </td>

                                <td class="text-end fw-bold text-success">
                                    R$ {{ venda.valorTotal|number_format(2, ',', '.') }}
                                </td>

                                <td class="text-center">
                                    {% if venda.status == 1 %}
                                        <span class="badge bg-success">Concluída</span>
                                    {% elseif venda.status == 2 %}
                                        <span class="badge bg-warning text-dark">Cancelada</span>
                                    {% else %}
                                        <span class="badge bg-info text-dark">Em aberto</span>
                                    {% endif %}
                                </td>

                                <td class="text-end pe-4">
                                    <a href="{{ path('venda_recibo', {id: venda.id}) }}" class="btn btn-sm btn-primary" title="Ver Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                           </tr>
                        {% else %}
                            <tr>
                                <td class="text-center text-muted">
                                    Nenhuma venda registrada hoje.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <div class="card-footer bg-white text-center">
                <a href="{{ path('listar_vendas') }}" class="btn btn-outline-dark px-4">
                    Ver histórico completo
                </a>
            </div>

        </div>
    </div>
</div>
{% endblock %}
