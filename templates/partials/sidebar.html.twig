{% set current_path = app.request.pathInfo %}

<nav class="sidebar d-flex flex-column p-3">
    <a href="{{ path('app') }}" class="d-flex align-items-center text-white text-decoration-none">
        <h3 class="text-white mt-3">
            <i class="bi bi-code-square"></i>
            Dashboard
        </h3>
    </a>

    <hr class="text-secondary">

    <ul class="nav nav-pills flex-column">
        <li class="nav-item">
            <a href="{{ path('pdv_novaVenda') }}" 
               class="nav-link d-flex align-items-center text-white text-decoration-none 
               {{ app.request.pathInfo starts with '/pdv' ? 'active' : '' }}">
                <i class="bi bi-shop fs-4 me-2"></i>
                PDV
            </a>
        </li>
    </ul>

    <hr class="text-secondary">

    <ul class="nav nav-pills flex-column">
        <li class="nav-item">
            <a href="{{ path('listar_categorias') }}" 
               class="nav-link d-flex align-items-center text-white text-decoration-none 
               {% if current_path starts with path('listar_categorias') %}active{% endif %}">
                <i class="bi bi-tags fs-4 me-2"></i>
                Categorias
            </a>
        </li>

        <li class="nav-item">
            <a href="{{ path('listar_produtos') }}" 
               class="nav-link d-flex align-items-center text-white text-decoration-none
               {% if current_path starts with path('listar_produtos') %}active{% endif %}">
                <i class="bi bi-box-seam fs-4 me-2"></i>
                Produtos
            </a>
        </li>

        <li class="nav-item">
            <a href="{{ path('listar_vendas') }}" class="nav-link d-flex align-items-center text-white text-decoration-none
            {% if current_path starts with path('listar_vendas') %}active{% endif %}">
                <i class="bi bi-currency-dollar fs-4 me-2"></i>
                Vendas
            </a>
        </li>
    </ul>

    <hr class="text-secondary">

    <ul class="nav nav-pills flex-column">
        <li class="nav-item">
            <a href="{{ path('clientes_index')}}" 
              class="nav-link d-flex align-items-center text-white text-decoration-none
              {% if current_path starts with path('clientes_index') %}active{% endif %}" 
              >
                <i class="bi bi-person-video2 fs-4 me-2"></i>
                Clientes
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('listar_usuarios') }}" 
               class="nav-link d-flex align-items-center text-white text-decoration-none
               {% if current_path starts with path('listar_usuarios') %}active{% endif %}"
               >
                <i class="bi bi-person-circle fs-4 me-2"></i>
                Usuários
            </a>
        </li>
    </ul>

     <hr class="text-secondary">

    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a href="{{ path('app_sobre') }}" 
              class="nav-link d-flex align-items-center text-white text-decoration-none
              {% if current_path starts with path('app_sobre') %}active{% endif %}">
                <i class="bi bi-info-circle-fill fs-4 me-2"></i>
                Sobre
            </a>
        </li>
    </ul>
</nav>