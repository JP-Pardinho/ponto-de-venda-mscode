{% extends 'base.html.twig' %}

{% block title %}PDV - Visualizar usuário{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-person-circle me-2"></i>  
                        Usuário #{{ usuario.id }}
                    </h1>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('listar_usuarios') }}">
                            <i class="bi bi-list-ul"></i> Listar usuários
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_usuario') }}">
                            <i class="bi bi-plus"></i> Novo usuário
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black active" href="#">
                            <i class="bi bi-eye"></i> Visualizar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('editar_usuario', {usuario: usuario.id}) }}">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>

                <div class="w-100 mt-4">
                    {% include "/partials/error-mensage.html.twig" %}

                    <form>
                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome:</label>
                            <input type="text"
                                   class="form-control"
                                   value="{{ usuario.nome }}"
                                   aria-label="Nome"
                                   disabled
                                   readonly>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email:</label>
                            <input type="text"
                                   class="form-control"
                                   value="{{ usuario.email }}"
                                   aria-label="Email"
                                   disabled
                                   readonly>
                        </div>

                        <div class="mb-3">
                            <label for="cargo" class="form-label">Cargo:</label>
                            <input type="text"
                                   class="form-control"
                                   value="{{ 'ROLE_ADMIN' in usuario.roles ? 'Administrador' : 'Operador' }}"
                                   aria-label="Cargo"
                                   disabled
                                   readonly>
                        </div>
                        
                        <div class="d-flex flex-column flex-md-row justify-content-md-end mt-3">
                            <a href="javascript:history.back()" class="btn btn-secondary w-100 w-md-auto">
                                Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}