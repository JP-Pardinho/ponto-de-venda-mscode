{% extends 'base.html.twig' %}

{% block title %}PDV - Usuários{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="container py-5">
                <div class="mb-4 d-flex flex-row justify-content-between">
                    <h1>
                        <i class="bi bi-person-circle"></i> Usuários
                    </h1>
                </div>
                
                <ul class="nav nav-tabs mb-3">

                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-list-ul"></i> Listar usuários
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_usuario') }}">
                            <i class="bi bi-plus"></i> Novo usuário
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" disabled>
                            <i class="bi bi-eye"></i> Vizualizar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" disabled>
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>
                
                {% include '/partials/error-mensage.html.twig' %}

                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Nome</th>
                            <th scope="col">Email</th>
                            <th scope="col">Cargo</th>
                            <th scope="col" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for usuario in usuarios %}
                        <tr class="align-middle">
                            <td>{{ usuario.nome }}</td>
                            <td>{{ usuario.email }}</td>
                            <td>
                                {% set cor_badge = 'bg-info' %}
    
                                {% if not usuario.ativo %}
                                    {% set cor_badge = 'bg-danger' %}
                                {% elseif 'ROLE_ADMIN' in usuario.roles %}
                                    {% set cor_badge = 'bg-dark' %}
                                {% endif %}

                                <span class="badge {{ cor_badge }}">
                                    {{ usuario.cargo }}
                                </span>
                            </td>
                            
                            <td class="col-1">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex gap-1">
                                    {% set inativo = '' %}
                                    {% if not usuario.ativo %}
                                        {% set inativo = 'disabled' %}
                                    {% endif %}

                                        <a type="button"
                                           class="btn btn-primary btn-sm flex-fill {{ inativo }}"
                                           title="Vizualizar"
                                           href="{{ path('ver_usuario', {id: usuario.id}) }}"
                                        >
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        
                                        <a type="button"
                                           class="btn btn-secondary btn-sm flex-fill {{ inativo }}"
                                           title="Editar"
                                           href="{{ path('editar_usuario', {usuario: usuario.id}) }}"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        
                                    {% if usuario.ativo %}
                                        {% set message = 'Você tem certeza que deseja inativar este usuario?' %}

                                        <form action="{{ path('remover_usuario', {usuario: usuario.id}) }}" 
                                              method="POST" 
                                              class="flex-fill">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ usuario.id) }}">
                                            <button type="submit"
                                                    class="btn btn-danger btn-sm w-100"
                                                    title="Excluir"
                                                    onclick="return confirm('{{ message }}')">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    {% else %}
                                        <form action="{{ path('reativar_usuario', {usuario: usuario.id}) }}" method="POST">
                                            <button type="submit" class="btn btn-success btn-sm" title="Reativar">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </form>
                                    {% endif %}   
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}