{% extends 'base.html.twig' %}

{% block title %}PDV - Usuários{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-person-circle me-2"></i>
                        Usuários
                    </h1>
                </div>
                
                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-list-ul"></i> Listar usuários
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('salvar_usuario') }}">
                            <i class="bi bi-plus"></i> Novo usuário
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" tabindex="-1">
                            <i class="bi bi-eye"></i> Visualizar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" tabindex="-1">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>
                
                {% include '/partials/error-mensage.html.twig' %}

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Nome</th>
                                <th scope="col">Email</th>
                                <th scope="col">Cargo</th>
                                <th scope="col" class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for usuario in usuarios %}
                                <tr class="align-middle">
                                    <td>{{ usuario.nome }}</td>
                                    <td>{{ usuario.email }}</td>
                                    <td>
                                        {% set cor_badge = 'bg-info' %}

                                        {% if not usuario.ativo %}
                                            {% set cor_badge = 'bg-danger' %}
                                        {% elseif 'ROLE_ADMIN' in usuario.roles %}
                                            {% set cor_badge = 'bg-dark' %}
                                        {% endif %}

                                        <span class="badge {{ cor_badge }}">
                                            {{ usuario.cargo }}
                                        </span>
                                    </td>
                                    
                                    <td class="text-center">
                                        <div class="d-inline-flex flex-wrap justify-content-center gap-1">
                                            {% set inativo = '' %}
                                            {% if not usuario.ativo %}
                                                {% set inativo = 'disabled' %}
                                            {% endif %}

                                            <a
                                                class="btn btn-primary btn-sm {{ inativo }}"
                                                title="Visualizar"
                                                href="{{ path('ver_usuario', {id: usuario.id}) }}"
                                            >
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            
                                            <a
                                                class="btn btn-secondary btn-sm {{ inativo }}"
                                                title="Editar"
                                                href="{{ path('editar_usuario', {usuario: usuario.id}) }}"
                                            >
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            
                                            {% if usuario.ativo %}
                                                {% set message = 'Você tem certeza que deseja inativar este usuário?' %}

                                                <form action="{{ path('remover_usuario', {usuario: usuario.id}) }}" 
                                                      method="POST" 
                                                      class="d-inline-block">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ usuario.id) }}">
                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm"
                                                            title="Inativar"
                                                            onclick="return confirm('{{ message }}')">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form action="{{ path('reativar_usuario', {usuario: usuario.id}) }}" method="POST" class="d-inline-block">
                                                    <button type="submit" class="btn btn-success btn-sm" title="Reativar">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                </form>
                                            {% endif %}   
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center">Nenhum usuário encontrado.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div> 
            </div>
        </div>
    </div>
</div>
{% endblock %}