{% extends 'base.html.twig' %}

{% block title %}PDV - Detalhes do Cliente{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-person-badge-fill me-2"></i>
                        Cliente: {{ cliente.nome }}
                    </h1>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('clientes_index') }}">
                            <i class="bi bi-list-ul"></i> Listar clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('clientes_novo') }}">
                            <i class="bi bi-plus"></i> Novo cliente
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black active" href="#">
                            <i class="bi bi-eye"></i> Visualizar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('clientes_editar', {id: cliente.id}) }}">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>

                <div class="w-100 mt-4">
                    {% include 'partials/error-mensage.html.twig' %}

                    <form>
                        <div class="mb-3">
                            <label class="form-label">Nome:</label>
                            <input type="text"
                                   class="form-control"
                                   value="{{ cliente.nome }}"
                                   disabled readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">CPF:</label>
                            <input type="text"
                                   class="form-control"
                                   value="{{ cliente.cpfFormatado }}"
                                   disabled readonly>
                        </div>

                        <div class="row g-3">
                            <div class="mb-3 col-12 col-md-6">
                                <label class="form-label">Telefone:</label>
                                <input type="text"
                                       class="form-control"
                                       value="{{ cliente.telefoneFormatado }}"
                                       disabled readonly>
                            </div>

                            <div class="mb-3 col-12 col-md-6">
                                <label class="form-label">Email:</label>
                                <input type="text"
                                       class="form-control"
                                       value="{{ cliente.email }}"
                                       disabled readonly>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-md-end mt-3">
                            <a href="{{ path('clientes_index') }}" class="btn btn-secondary w-100 w-md-auto">
                                Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
