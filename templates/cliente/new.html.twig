{% extends 'base.html.twig' %}

{% block title %}PDV - Novo Cliente{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body py-4">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h1 class="h3 mb-2 mb-md-0">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Novo cliente
                    </h1>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('clientes_index') }}">
                            <i class="bi bi-list-ul"></i> Listar clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            <i class="bi bi-plus"></i> Novo cliente
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" tabindex="-1">
                            <i class="bi bi-eye"></i> Visualizar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" tabindex="-1">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>

                {% include 'partials/error-mensage.html.twig' %}

                <div class="w-100 mt-4">
                    {{ form_start(form) }}
                        {{ include('cliente/_form.html.twig') }}

                        <div class="d-flex flex-column flex-md-row justify-content-md-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Cadastrar
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}