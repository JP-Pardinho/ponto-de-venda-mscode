{% extends 'base.html.twig' %}

{% block title %}PDV - Clientes{% endblock %}

{% block body %}
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="container py-5">
                <div class="mb-4 d-flex flex-row justify-content-between">
                    <h1><i class="bi bi-people-fill"></i> Clientes</h1>
                </div>

                <ul class="nav nav-tabs mb-3">
                
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('clientes_index') }}">
                            <i class="bi bi-list-ul"></i> Listar clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-black" href="{{ path('clientes_novo') }}">
                            <i class="bi bi-plus"></i> Novo cliente
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" disabled>
                            <i class="bi bi-eye"></i> Vizualizar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link disabled" href="#" aria-disabled="true" disabled>
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </li>
                </ul>

                {% include 'partials/error-mensage.html.twig' %}

                <form method="get" class="mb-3" action="{{ path('clientes_index') }}">
                    <div class="input-group">
                        <input
                            type="search"
                            name="q"
                            value="{{ q|default('') }}"
                            class="form-control"
                            placeholder="Buscar por nome ou CPF"
                        >
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </form>

                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Nome</th>
                            <th scope="col">CPF</th>
                            <th scope="col">Telefone</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cliente in clientes %}
                            <tr class="align-middle">
                                <td>{{ cliente.nome }}</td>
                                <td>{{ cliente.cpf }}</td>
                                <td>{{ cliente.telefone }}</td>
                                <td>{{ cliente.email }}</td>
                                <td>
                                    {% if cliente.isAtivo %}
                                        <span class="badge bg-success">Ativo</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Inativo</span>
                                    {% endif %}
                                </td>
                                <td class="col-1">
                                    <div class="d-flex flex-column gap-2">
                                        <div class="d-flex gap-1">
                                            {% set inativo = '' %}
                                            {% if not cliente.ativo %}
                                                {% set inativo = 'disabled' %}
                                            {% endif %}

                                            <a
                                                class="btn btn-primary btn-sm flex-fill {{ inativo }}"
                                                title="Visualizar"
                                                href="{{ path('clientes_ver', {id: cliente.id}) }}"
                                            >
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a
                                                class="btn btn-secondary btn-sm flex-fill {{ inativo }}"
                                                title="Editar"
                                                href="{{ path('clientes_editar', {id: cliente.id}) }}"
                                            >
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            {% if cliente.isAtivo %}
                                            <form
                                                action="{{ path('clientes_delete', {id: cliente.id}) }}"
                                                method="POST"
                                                class="flex-fill"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('delete' ~ cliente.id) }}"
                                                >
                                                <button
                                                    type="submit"
                                                    class="btn btn-danger btn-sm w-100"
                                                    title="Desativar"
                                                    onclick="return confirm('Confirma a desativação deste cliente?')"
                                                >
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        

                                            {% else %}
                                            <form
                                                action="{{ path('clientes_restaurar', {id: cliente.id}) }}"
                                                method="POST"
                                                class="flex-fill"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('restore' ~ cliente.id) }}"
                                                >
                                                <button
                                                    type="submit"
                                                    class="btn btn-success btn-sm w-100"
                                                    title="Reativar"
                                                >
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        </div>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">Nenhum cliente encontrado.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>
{% endblock %}